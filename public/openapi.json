                      "redo",
                      "none"
                    ]
                  },
                  "refundAmount": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "arbiter": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "finding": "upheld",
                "remedy": "full_refund",
                "refundAmount": "$0.75",
                "arbiter": "arbiter-1",
